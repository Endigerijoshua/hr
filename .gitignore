# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- Python (ml/, resume_screening/) ---
__pycache__/
*.pyc
clips/
tmp/
syncnet_python/

# --- Node / Next.js dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# --- local scratch artefacts (NOT the committed demo asset) ---
# test_clip.* and shot-*.png are local debug output. Note that demo_clip.mp4 is
# deliberately NOT ignored: DEMO_SCRIPT.md documents it as the fallback-C asset
# and a fresh clone needs it to run that path.
test_clip.*
shot-*.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma / sqlite
# migrations are committed; the local database file is not
prisma/*.db
prisma/*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
