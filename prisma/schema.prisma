// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Candidate {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  domain               String
  /// Comma-separated skills extracted from the resume. Stored (not just kept
  /// in the PDF) so the shortlist scorer can measure overlap against a job's
  /// requiredSkills — without it, quality is invisible to ranking.
  skills               String                @default("")
  resumeFileUrl        String?
  verified             Boolean               @default(false)
  applications         Application[]
  verificationSessions VerificationSession[]
}

model Job {
  id             String        @id @default(cuid())
  companyName    String
  title          String
  domain         String
  description    String
  requiredSkills String // store as comma-separated for simplicity
  applications   Application[]
}

model Application {
  id             String    @id @default(cuid())
  candidateId    String
  jobId          String
  shortlistScore Float?
  shortlisted    Boolean   @default(false)
  status         String    @default("applied")
  candidate      Candidate @relation(fields: [candidateId], references: [id])
  job            Job       @relation(fields: [jobId], references: [id])
}

model VerificationSession {
  id            String    @id @default(cuid())
  candidateId   String
  gazeScore     Float
  lipSyncScore  Float
  audioScore    Float
  livenessScore Float
  result        String
  reviewedByHR  Boolean   @default(false)
  candidate     Candidate @relation(fields: [candidateId], references: [id])
}
